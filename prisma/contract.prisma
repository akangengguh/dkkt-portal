// use prisma-8

// ============================================================
// CMS DKKT
// DATABASE CONTRACT
// PostgreSQL + Prisma 8
//
// Modul:
// 1. Authentication
// 2. RBAC
// 3. Committee
// 4. Committee Access
// 5. News
// 6. Agenda
// 7. Media Library
// 8. Gallery
// 9. Documents
// 10. Organization
// 11. Site Pages
// 12. Homepage Highlights
// 13. Site Settings
// 14. Social Links
// 15. Contact Messages
// 16. Audit Log
// ============================================================

// ============================================================
// USER
// ============================================================
model User {
  id                 String              @id @default(uuid())
  artistId           String?             @unique
  name               String
  username           String?             @unique
  email              String              @unique
  passwordHash       String
  status             String              @default("ACTIVE")
  lastLoginAt        DateTime?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now())

  roles              UserRole[]
  artist             Artist?             @relation(fields:[artistId], references:[id], onDelete: SetNull)

  committeeAccess    CommitteeUser[]

  auditLogs          AuditLog[]

  // ----------------------------------------------------------
  // NEWS
  // ----------------------------------------------------------
  newsCreated        News[]              @relation("NewsCreatedBy")
  newsUpdated        News[]              @relation("NewsUpdatedBy")
  newsPublished      News[]              @relation("NewsPublishedBy")

  newsRejected       News[]              @relation("NewsRejectedBy")
  newsReviewed       News[]              @relation("NewsReviewedBy")

  newsWorkflowLogs   NewsWorkflowLog[]

  // ----------------------------------------------------------
  // AGENDA
  // ----------------------------------------------------------
  agendasCreated     Agenda[]            @relation("AgendaCreatedBy")
  agendasUpdated     Agenda[]            @relation("AgendaUpdatedBy")
  agendasPublished   Agenda[]            @relation("AgendaPublishedBy")

  agendasRejected    Agenda[]            @relation("AgendaRejectedBy")
  agendasReviewed    Agenda[]            @relation("AgendaReviewedBy")

  agendaWorkflowLogs AgendaWorkflowLog[]

  // ----------------------------------------------------------
  // SITE PAGE
  // ----------------------------------------------------------
  pagesCreated       SitePage[]          @relation("PageCreatedBy")
  pagesUpdated       SitePage[]          @relation("PageUpdatedBy")
  pagesPublished     SitePage[]          @relation("PagePublishedBy")

  @@map("user")
}

// ============================================================
// ROLE
// ============================================================
model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now())

  users       UserRole[]
  permissions RolePermission[]

  @@map("role")
}

// ============================================================
// PERMISSION
// ============================================================
model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now())

  roles       RolePermission[]

  @@map("permission")
}

// ============================================================
// USER ↔ ROLE
// ============================================================
model UserRole {
  userId String
  roleId String

  user   User   @relation(fields:[userId], references:[id], onDelete: Cascade)

  role   Role   @relation(fields:[roleId], references:[id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("userRole")
}

// ============================================================
// ROLE ↔ PERMISSION
// ============================================================
model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields:[roleId], references:[id], onDelete: Cascade)

  permission   Permission @relation(fields:[permissionId], references:[id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("rolePermission")
}

// ============================================================
// KOMITE
// ============================================================
model Committee {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique
  shortName    String?
  description  String?
  icon         String?
  coverImage   String?
  chairman     String?
  chairmanArtistId String?

  sortOrder    Int               @default(0)
  isActive     Boolean           @default(true)

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now())

  members      CommitteeMember[]

  chairmanArtist Artist? @relation("CommitteeChairman", fields:[chairmanArtistId], references:[id], onDelete: SetNull)

  userAccess   CommitteeUser[]

  news         News[]

  agendas      Agenda[]

  galleryItems GalleryItem[]

  @@index([isActive, sortOrder])
  @@map("committee")
}

// ============================================================
// ANGGOTA KOMITE
// ============================================================
model CommitteeMember {
  id          String    @id @default(uuid())
  committeeId String

  name        String
  position    String
  photo       String?
  biography   String?

  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)

  committee   Committee @relation(fields:[committeeId], references:[id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  @@index([committeeId])
  @@index([isActive, sortOrder])
  @@map("committeeMember")
}

// ============================================================
// USER ↔ KOMITE
// ============================================================
model CommitteeUser {
  userId      String
  committeeId String

  // VIEWER
  // CONTRIBUTOR
  // EDITOR
  // MANAGER
  accessLevel String    @default("EDITOR")

  user        User      @relation(fields:[userId], references:[id], onDelete: Cascade)

  committee   Committee @relation(fields:[committeeId], references:[id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@id([userId, committeeId])
  @@index([committeeId])
  @@map("committeeUser")
}

// ============================================================
// KATEGORI BERITA
// ============================================================
model NewsCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?

  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  news        News[]

  @@index([isActive, sortOrder])
  @@map("newsCategory")
}

// ============================================================
// BERITA
// ============================================================
model News {
  id              String            @id @default(uuid())
  title           String
  slug            String            @unique
  subtitle        String?
  excerpt         String?
  content         String
  featuredImage   String?

  // ----------------------------------------------------------
  // WORKFLOW STATUS
  // ----------------------------------------------------------
  // DRAFT
  // REVIEW
  // APPROVED
  // PUBLISHED
  // REJECTED
  // ARCHIVED
  // ----------------------------------------------------------
  status          String            @default("DRAFT")

  isFeatured      Boolean           @default(false)
  isPublished     Boolean           @default(false)

  categoryId      String?
  committeeId     String?

  createdById     String
  updatedById     String?
  publishedById   String?

  publishedAt     DateTime?

  // ----------------------------------------------------------
  // REVIEW / REJECTION
  // ----------------------------------------------------------
  rejectionReason String?
  rejectedById    String?
  rejectedAt      DateTime?

  reviewedById    String?
  reviewedAt      DateTime?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now())

  // ----------------------------------------------------------
  // CATEGORY
  // ----------------------------------------------------------
  category        NewsCategory?     @relation(fields:[categoryId], references:[id], onDelete: SetNull)

  // ----------------------------------------------------------
  // COMMITTEE
  // ----------------------------------------------------------
  committee       Committee?        @relation(fields:[committeeId], references:[id], onDelete: SetNull)

  // ----------------------------------------------------------
  // CREATED BY
  // ----------------------------------------------------------
  createdBy       User              @relation("NewsCreatedBy", fields:[createdById], references:[id])

  // ----------------------------------------------------------
  // UPDATED BY
  // ----------------------------------------------------------
  updatedBy       User?             @relation("NewsUpdatedBy", fields:[updatedById], references:[id], onDelete: SetNull)

  // ----------------------------------------------------------
  // PUBLISHED BY
  // ----------------------------------------------------------
  publishedBy     User?             @relation("NewsPublishedBy", fields:[publishedById], references:[id], onDelete: SetNull)

  // ----------------------------------------------------------
  // REJECTED BY
  // ----------------------------------------------------------
  rejectedBy      User?             @relation("NewsRejectedBy", fields:[rejectedById], references:[id], onDelete: SetNull)

  // ----------------------------------------------------------
  // REVIEWED BY
  // ----------------------------------------------------------
  reviewedBy      User?             @relation("NewsReviewedBy", fields:[reviewedById], references:[id], onDelete: SetNull)

  // ----------------------------------------------------------
  // WORKFLOW HISTORY
  // ----------------------------------------------------------
  workflowLogs    NewsWorkflowLog[]

  // ----------------------------------------------------------
  // INDEX
  // ----------------------------------------------------------
  @@index([status])
  @@index([committeeId])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([isFeatured])
  @@index([rejectedById])
  @@index([reviewedById])
  @@map("news")
}

// ============================================================
// NEWS WORKFLOW LOG
// ============================================================
model NewsWorkflowLog {
  id        String   @id @default(uuid())

  newsId    String
  actorId   String

  action    String

  note      String?

  createdAt DateTime @default(now())

  news      News     @relation(fields:[newsId], references:[id], onDelete: Cascade)

  actor     User     @relation(fields:[actorId], references:[id], onDelete: Cascade)

  @@index([newsId])
  @@index([actorId])
  @@index([createdAt])
  @@map("newsWorkflowLog")
}

// ============================================================
// KATEGORI AGENDA
// ============================================================
model AgendaCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?

  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  agendas     Agenda[]

  @@index([isActive, sortOrder])
  @@map("agendaCategory")
}

// ============================================================
// AGENDA
// ============================================================
model Agenda {
  id               String              @id @default(uuid())
  title            String
  slug             String              @unique
  description      String
  excerpt          String?
  image            String?

  // ----------------------------------------------------------
  // WORKFLOW STATUS
  // ----------------------------------------------------------
  // DRAFT
  // REVIEW
  // APPROVED
  // PUBLISHED
  // REJECTED
  // ARCHIVED
  // ----------------------------------------------------------
  status           String              @default("DRAFT")

  isFeatured       Boolean             @default(false)
  isPublished      Boolean             @default(false)

  committeeId      String?
  categoryId       String?

  startDate        DateTime
  endDate          DateTime?

  startTime        String?
  endTime          String?

  location         String?
  address          String?

  registrationUrl  String?
  registrationText String?

  contactName      String?
  contactPhone     String?
  contactEmail     String?

  organizer        String?
  target           String?
  notes            String?

  createdById      String
  updatedById      String?
  publishedById    String?

  publishedAt      DateTime?

  // ----------------------------------------------------------
  // REVIEW / REJECTION
  // ----------------------------------------------------------
  rejectionReason  String?
  rejectedById     String?
  rejectedAt       DateTime?

  reviewedById     String?
  reviewedAt       DateTime?

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now())

  // ----------------------------------------------------------
  // COMMITTEE
  // ----------------------------------------------------------
  committee        Committee?          @relation(fields:[committeeId], references:[id], onDelete: SetNull)

  // ----------------------------------------------------------
  // CATEGORY
  // ----------------------------------------------------------
  category         AgendaCategory?     @relation(fields:[categoryId], references:[id], onDelete: SetNull)

  // ----------------------------------------------------------
  // CREATED BY
  // ----------------------------------------------------------
  createdBy        User                @relation("AgendaCreatedBy", fields:[createdById], references:[id])

  // ----------------------------------------------------------
  // UPDATED BY
  // ----------------------------------------------------------
  updatedBy        User?               @relation("AgendaUpdatedBy", fields:[updatedById], references:[id], onDelete: SetNull)

  // ----------------------------------------------------------
  // PUBLISHED BY
  // ----------------------------------------------------------
  publishedBy      User?               @relation("AgendaPublishedBy", fields:[publishedById], references:[id], onDelete: SetNull)

  // ----------------------------------------------------------
  // REJECTED BY
  // ----------------------------------------------------------
  rejectedBy       User?               @relation("AgendaRejectedBy", fields:[rejectedById], references:[id], onDelete: SetNull)

  // ----------------------------------------------------------
  // REVIEWED BY
  // ----------------------------------------------------------
  reviewedBy       User?               @relation("AgendaReviewedBy", fields:[reviewedById], references:[id], onDelete: SetNull)

  // ----------------------------------------------------------
  // WORKFLOW HISTORY
  // ----------------------------------------------------------
  workflowLogs     AgendaWorkflowLog[]

  // ----------------------------------------------------------
  // INDEX
  // ----------------------------------------------------------
  @@index([status])
  @@index([committeeId])
  @@index([categoryId])
  @@index([startDate])
  @@index([isFeatured])
  @@index([rejectedById])
  @@index([reviewedById])
  @@map("agenda")
}

// ============================================================
// AGENDA WORKFLOW LOG
// ============================================================
model AgendaWorkflowLog {
  id        String   @id @default(uuid())

  agendaId  String
  actorId   String

  action    String

  note      String?

  createdAt DateTime @default(now())

  agenda    Agenda   @relation(fields:[agendaId], references:[id], onDelete: Cascade)

  actor     User     @relation(fields:[actorId], references:[id], onDelete: Cascade)

  @@index([agendaId])
  @@index([actorId])
  @@index([createdAt])
  @@map("agendaWorkflowLog")
}

// ============================================================
// MEDIA LIBRARY
// ============================================================
model MediaFile {
  id           String        @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int

  url          String
  thumbnailUrl String?
  altText      String?
  caption      String?
  folder       String?

  width        Int?
  height       Int?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now())

  galleryItems GalleryItem[]

  @@index([mimeType])
  @@index([folder])
  @@index([createdAt])
  @@map("mediaFile")
}

// ============================================================
// GALERI ALBUM
// ============================================================
model GalleryAlbum {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  description String?
  coverImage  String?

  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now())

  items       GalleryItem[]

  @@index([isActive, sortOrder])
  @@map("galleryAlbum")
}

// ============================================================
// GALERI ITEM
// ============================================================
model GalleryItem {
  id           String       @id @default(uuid())
  albumId      String

  committeeId  String?
  mediaId      String?

  // PHOTO
  // VIDEO
  type         String

  title        String
  description  String?

  fileUrl      String?

  thumbnailUrl String?

  externalUrl  String?

  mimeType     String?
  width        Int?
  height       Int?
  duration     Int?

  eventDate    DateTime?

  sortOrder    Int          @default(0)
  isActive     Boolean      @default(true)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now())

  album        GalleryAlbum @relation(fields:[albumId], references:[id], onDelete: Cascade)

  committee    Committee?   @relation(fields:[committeeId], references:[id], onDelete: SetNull)

  media        MediaFile?   @relation(fields:[mediaId], references:[id], onDelete: SetNull)

  @@index([albumId, sortOrder])
  @@index([committeeId])
  @@index([mediaId])
  @@index([type])
  @@index([eventDate])
  @@map("galleryItem")
}

// ============================================================
// DOKUMEN
// ============================================================
model Document {
  id             String    @id @default(uuid())
  title          String
  documentNumber String?
  documentType   String?
  description    String?

  fileUrl        String
  fileName       String?
  mimeType       String?
  fileSize       Int?

  isPublished    Boolean   @default(false)
  sortOrder      Int       @default(0)

  publishedAt    DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  @@index([documentType])
  @@index([isPublished, sortOrder])
  @@map("document")
}

// ============================================================
// STRUKTUR ORGANISASI
// ============================================================
model OrganizationSection {
  id          String               @id @default(uuid())
  name        String
  slug        String               @unique
  description String?

  sortOrder   Int                  @default(0)
  isActive    Boolean              @default(true)

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now())

  members     OrganizationMember[]

  @@index([isActive, sortOrder])
  @@map("organizationSection")
}

// ============================================================
// ANGGOTA STRUKTUR ORGANISASI
// ============================================================
model OrganizationMember {
  id        String              @id @default(uuid())
  sectionId String
  artistId  String?

  name      String
  position  String
  photo     String?
  biography String?

  sortOrder Int                 @default(0)
  isActive  Boolean             @default(true)

  section   OrganizationSection @relation(fields:[sectionId], references:[id], onDelete: Cascade)
  artist    Artist?             @relation(fields:[artistId], references:[id], onDelete: SetNull)

  createdAt DateTime            @default(now())
  updatedAt DateTime            @default(now())

  @@index([sectionId])
  @@index([isActive, sortOrder])
  @@map("organizationMember")
}

// ============================================================
// SENIMAN & BUDAYAWAN
// ============================================================
model Artist {
  id          String   @id @default(uuid())
  registrationNumber String   @unique
  registrationStatus String   @default("PENDING")
  name        String
  slug        String   @unique
  committeeId String?
  discipline  String?
  biography   String?
  photo       String?
  email       String?
  phone       String?
  website     String?
  birthPlace  String?
  birthDate   DateTime?
  gender      String?
  address     String?
  skNumber    String?
  skDate      DateTime?
  skFileUrl   String?
  cardIssuedAt DateTime?
  cardFileUrl String?

  sortOrder   Int      @default(0)
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  registeredAt DateTime @default(now())
  verifiedAt  DateTime?
  verifiedBy  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  committee   Committee? @relation(fields:[committeeId], references:[id], onDelete: SetNull)
  cmsUser     User?
  committeeChairmanships Committee[] @relation("CommitteeChairman")
  organizationMemberships OrganizationMember[]

  @@index([isActive, sortOrder])
  @@index([discipline])
  @@index([committeeId, registrationStatus])
  @@index([registrationStatus, registeredAt])
  @@map("artist")
}

// ============================================================
// KELOMPOK / KOMUNITAS / SANGGAR
// ============================================================
model CulturalGroup {
  id          String   @id @default(uuid())
  registrationNumber String   @unique
  registrationStatus String   @default("PENDING")
  name        String
  slug        String   @unique
  committeeId String?
  groupType   String   @default("SANGGAR")
  description String?
  leader      String?
  address     String?
  email       String?
  phone       String?
  website     String?
  logo        String?
  establishedDate DateTime?
  memberCount Int?
  skNumber    String?
  skDate      DateTime?
  skFileUrl   String?
  cardIssuedAt DateTime?
  cardFileUrl String?

  sortOrder   Int      @default(0)
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  registeredAt DateTime @default(now())
  verifiedAt  DateTime?
  verifiedBy  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  committee   Committee? @relation(fields:[committeeId], references:[id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@index([groupType])
  @@index([committeeId, registrationStatus])
  @@index([registrationStatus, registeredAt])
  @@map("culturalGroup")
}

// ============================================================
// NOMOR REGISTRASI EKOSISTEM
// ============================================================
model RegistrationSequence {
  id        String   @id @default(uuid())
  scopeKey  String   @unique
  category  String
  committeeId String?
  year      Int
  lastNumber Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([category, committeeId, year])
  @@map("registrationSequence")
}

// ============================================================
// HALAMAN WEBSITE
// ============================================================
model SitePage {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String

  featuredImage  String?

  status         String    @default("DRAFT")
  isPublished    Boolean   @default(false)

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?

  createdById    String
  updatedById    String?
  publishedById  String?

  publishedAt    DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  createdBy      User      @relation("PageCreatedBy", fields:[createdById], references:[id])

  updatedBy      User?     @relation("PageUpdatedBy", fields:[updatedById], references:[id], onDelete: SetNull)

  publishedBy    User?     @relation("PagePublishedBy", fields:[publishedById], references:[id], onDelete: SetNull)

  @@index([status])
  @@index([isPublished])
  @@index([publishedAt])
  @@map("sitePage")
}

// ============================================================
// HOMEPAGE HIGHLIGHT / SLIDER
// ============================================================
model HomeHighlight {
  id          String    @id @default(uuid())

  title       String
  subtitle    String?
  description String?

  imageUrl    String
  linkUrl     String?

  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)

  startAt     DateTime?
  endAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  @@index([isActive, sortOrder])
  @@index([startAt, endAt])
  @@map("homeHighlight")
}

// ============================================================
// WEBSITE SETTINGS
// ============================================================
model SiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@map("siteSetting")
}

// ============================================================
// SOCIAL MEDIA
// ============================================================
model SocialLink {
  id        String   @id @default(uuid())
  platform  String
  label     String
  url       String
  icon      String?

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([isActive, sortOrder])
  @@map("socialLink")
}

// ============================================================
// PESAN KONTAK
// ============================================================
model ContactMessage {
  id        String    @id @default(uuid())

  name      String
  email     String
  phone     String?
  subject   String
  message   String

  status    String    @default("UNREAD")

  repliedAt DateTime?
  repliedBy String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("contactMessage")
}

// ============================================================
// AUDIT LOG
// ============================================================
model AuditLog {
  id        String   @id @default(uuid())

  userId    String?

  action    String
  entity    String
  entityId  String?

  message   String?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user      User?    @relation(fields:[userId], references:[id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("auditLog")
}
